	RGB 30,28,26, 15,20,01, 09,13,00, 07,07,07 ; day
	RGB 15,14,24, 08,13,19, 00,11,13, 00,00,00 ; nite
	RGB 31,21,14, 10,19,01, 04,10,00, 06,05,05 ; eve
